{
  "name": "outbox-flow/server",
  "type": "project",
  "description": "Outbox Flow Server",
  "license": "Apache-2.0",
  "require": {
    "php": "^8.4",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "doctrine/doctrine-migrations-bundle": "^4.0",
    "php-amqplib/php-amqplib": "^3.7",
    "ramsey/uuid": "^4.9",
    "symfony/console": "^7.4",
    "symfony/dotenv": "^7.4",
    "symfony/framework-bundle": "^7.4",
    "symfony/orm-pack": "^2.7",
    "symfony/runtime": "^7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0",
    "symfony/maker-bundle": "^1.68"
  },
  "autoload": {
    "psr-4": {
      "OutboxFlow\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "OutboxFlow\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "symfony/runtime": true
    },
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit"
  }
}
